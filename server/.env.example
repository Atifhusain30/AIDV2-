# Server-only configuration. Copy to server/.env and fill locally.
SUPABASE_URL=https://jamnyrhnvvbweqooefaa.supabase.co
SUPABASE_SECRET_KEY=
DATABASE_URL=
DATABASE_SSL=true
# Optional PEM CA certificate for production databases. Use escaped newlines in a single-line env value.
DATABASE_CA=
HOST=127.0.0.1
PORT=3001
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Drivers see open requests within this many estimated road miles of where they are (1-100, default 25).
DRIVER_REQUEST_RADIUS_MILES=25
# A request no driver accepts within this many minutes expires ("No drivers were available") (1-240, default 15).
REQUEST_EXPIRY_MINUTES=15
# An accepted / on-the-way job is released when the driver sends no location or status for this long (15-1440, default 60).
STALE_JOB_MINUTES=60
# How often the server checks for expired requests and silent jobs, in seconds (5-3600, default 60).
EXPIRY_SWEEP_SECONDS=60

# Support contact shown in the apps (Help & Support). Leave empty to hide the option.
SUPPORT_EMAIL=
SUPPORT_PHONE=

# --- Security (E3 / E8) ---
# Browser origins allowed to call the API (comma-separated). Others get 403. Requests with no Origin
# (native HTTP, curl, Stripe webhooks) are allowed. Native apps: capacitor://localhost (iOS),
# https://localhost (Android, androidScheme https), http://localhost / ionic://localhost (older builds).
# Dev: admin site http://127.0.0.1:5173, app in a browser http://localhost:3000. Production: add the admin domain.
CORS_ORIGIN=capacitor://localhost,ionic://localhost,https://localhost,http://localhost,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000
# Behind a proxy/load balancer: number of trusted hops (usually 1) or a subnet list. Off locally.
TRUST_PROXY=false
# Send Strict-Transport-Security. Only when every client reaches the API over HTTPS.
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000
# Largest JSON request body (e.g. 100kb) and largest driver document upload in MB (max 25).
JSON_BODY_LIMIT=100kb
DOCUMENT_MAX_MB=10
# Structured JSON logs (redacted): debug | info | warn | error | silent
LOG_LEVEL=info
# Rate limits (in-memory: correct for ONE API instance; move to a shared store before scaling out).
# Emergency switch only — leave true.
RATE_LIMITS_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_BOOKING_CREATE_PER_HOUR=20
RATE_LIMIT_QUOTES_PER_HOUR=120
RATE_LIMIT_ACCEPT_PER_10_MINUTES=30
RATE_LIMIT_STATUS_CHANGES_PER_10_MINUTES=60
RATE_LIMIT_LOCATION_PER_MINUTE=60
RATE_LIMIT_DOCUMENT_UPLOADS_PER_HOUR=20
RATE_LIMIT_RATINGS_PER_HOUR=20
RATE_LIMIT_REPORTS_PER_HOUR=20
RATE_LIMIT_CHAT_SENDS_PER_MINUTE=60
RATE_LIMIT_BLOCKS_PER_HOUR=10
RATE_LIMIT_ACCOUNT_CHANGES_PER_HOUR=60
